CLANKERFIGHTS_BASE_URL=https://clankerfights.ai

# Optional if the Clankerfights API is protected in your environment.
# CLANKERFIGHTS_API_TOKEN=

# Required for OpenAI voice generation in default-template renders and
# POST /api/jobs/:id/tts. Without it, jobs can still be created and rendered,
# but TTS layers will not have generated audio assets.
# OPENAI_API_KEY=

# Optional: set to 1 for production auto-clipping so a render fails instead of
# silently continuing when default-template TTS audio cannot be generated.
# SHORT_FACTORY_REQUIRE_TTS=1

# Optional model for turning tone notes into voice directions.
# OPENAI_TONE_MODEL=gpt-5.5
